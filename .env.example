# ── Required ────────────────────────────────────────────────────────────────
# Tempo accounts whose agent keys and payments are watched (comma-separated).
WATCHED_ACCOUNTS=0xYourRootAccount

# ── Chain ───────────────────────────────────────────────────────────────────
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_CHAIN_ID=42431
# TOKENS=0x20C0000000000000000000000000000000000000:pathUSD
# START_BLOCK=0
# CONFIRMATIONS=2
# EXPLORER_URL=

# ── Server ──────────────────────────────────────────────────────────────────
# PORT=3000
# DB_PATH=./data/agent-spend.db
# Public origin (CSRF origin check) and proxy trust (rate limiting), e.g. on Railway:
# PUBLIC_URL=https://your-app.up.railway.app
# TRUST_PROXY=1

# ── Admin (required for any write from the dashboard; fails closed if unset) ─
# ADMIN_USER=ops
# ADMIN_PASSWORD=use-a-long-random-secret

# ── On-chain controls (optional) ────────────────────────────────────────────
# admin = an admin access key of OPERATOR_ACCOUNT (recommended)
# root  = the account's root key (testnet/demo only)
# devnet = local fixture only
# OPERATOR_MODE=admin
# OPERATOR_ACCOUNT=0xYourRootAccount
# OPERATOR_PRIVATE_KEY=0x...

# ── Alerts (optional) ───────────────────────────────────────────────────────
# ALERT_THRESHOLD_PCT=20
# WEBHOOK_URL=https://hooks.slack.com/services/...
